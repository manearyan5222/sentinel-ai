# SentinelAI Security & Environment Configuration
# Copy this file to backend/.env and configure appropriate values for your environment.

# 1. Operational Mode (Set to false for production deployment)
DEMO_MODE=true

# 2. JWT Authentication Secret Key (MANDATORY when DEMO_MODE=false)
# Generate a secure 32+ character random string in production
SECRET_KEY=change-this-to-a-long-random-secret

# 3. CORS Allowed Origins (Comma-separated list of trusted web client origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 4. Database Connection URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./sentinel_ai.db

# 5. Google Gemini AI API Key (Optional decision-support intelligence layer)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
